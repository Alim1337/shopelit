# ============================================================
# SHOPELITE - ENVIRONMENT VARIABLES
# Local development: copy this file to .env and fill in the values.
# Vercel: add the same variables in Project -> Settings -> Environment Variables.
# NEVER commit the real .env file.
# ============================================================

# --- Database (REQUIRED) ---
# Local:   postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecom_app
# Vercel:  Supabase "Transaction pooler" URL (port 6543):
#          postgresql://postgres.PROJECTREF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ecom_app"

# --- Site URL (OPTIONAL) ---
# Used for links in emails and SEO tags.
#   Local .env : http://localhost:3000
#   Vercel     : leave EMPTY and the Vercel URL is detected automatically.
#                Set it only if you attach a custom domain, e.g. https://www.myshop.dz
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ShopElite

# --- Cloudinary (REQUIRED for admin product image uploads) ---
# Free account: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# --- Email / SMTP (REQUIRED to send real emails) ---
# Gmail: use an App Password (Google Account -> Security -> App passwords), 16 letters, no spaces.
# EMAIL_FROM must be the same address as SMTP_USER when using Gmail.
# Without real values, emails are only printed in the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# --- Seed script only (not needed on Vercel) ---
# Required when seeding a REMOTE database; no default admin is created without it.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password

# --- Optional ---
# DB_POOL_MAX=5

# ------------------------------------------------------------
# Not used by the code yet (safe to leave out, also on Vercel):
# NEXTAUTH_*, GOOGLE_*, GITHUB_*, STRIPE_*, REDIS_URL, JWT_SECRET,
# NEXT_PUBLIC_GA_ID, NEXT_PUBLIC_META_PIXEL_ID, RATE_LIMIT_*
# ------------------------------------------------------------
